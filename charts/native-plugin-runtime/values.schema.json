{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean"},
    "replicaCount": {"type": "integer", "minimum": 1},
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "compatibility", "activeDeadlineSeconds", "backoffLimit", "serviceAccount", "profileSecret", "databaseSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "compatibility": {"enum": ["expand-only", "incompatible"]},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 10},
        "serviceAccount": {"$ref": "#/definitions/serviceAccount"},
        "profileSecret": {"$ref": "#/definitions/secretKeyReference"},
        "databaseSecret": {"$ref": "#/definitions/secretKeyReference"},
        "databaseCASecret": {"$ref": "#/definitions/secretKeyReference"}
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "port"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "port", "consoleOrigin", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "consoleOrigin": {"type": "string"},
        "resources": {"type": "object"},
        "gateway": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "className", "hostname", "certificateSecretName", "issuerName", "issuerKind"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "hostname": {"type": "string"},
            "certificateSecretName": {"type": "string"},
            "issuerName": {"type": "string"},
            "issuerKind": {"type": "string", "enum": ["Issuer", "ClusterIssuer"]}
          },
          "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {
            "className": {"minLength": 1},
            "hostname": {"pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
            "certificateSecretName": {"minLength": 1}
          }}}]
        }
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"consoleOrigin": {"pattern": "^https://[^/?#@]+$"}}}}]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "manifestSHA256", "installedDigest", "attestations", "plainHTTP", "registryConfigSecret"],
      "properties": {
        "reference": {"type": "string"},
        "installedDigest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sbom", "provenance"],
          "properties": {
            "sbom": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
            "provenance": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"}
          }
        },
        "manifestSHA256": {"type": "string"},
        "plainHTTP": {"type": "boolean"},
        "registryConfigSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bootstrapSecret", "signatureBundleSecret"],
      "properties": {
        "mode": {"enum": ["", "development-untrusted", "managed-key-no-tlog"]},
        "bootstrapSecret": {"$ref": "#/definitions/secretKeyReference"},
        "signatureBundleSecret": {"$ref": "#/definitions/secretKeyReference"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "oras", "cosign", "pullPolicy", "pullSecrets"],
      "properties": {
        "runtime": {"type": "string"},
        "oras": {"type": "string"},
        "cosign": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}, "additionalProperties": false}}
      }
    },
    "serviceAccount": {"$ref": "#/definitions/serviceAccount"},
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "audience", "expirationSeconds", "gateway", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "audience": {"type": "string"},
        "expirationSeconds": {"type": "integer", "minimum": 600, "maximum": 600},
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "caSecret"],
          "properties": {
            "url": {"type": "string"},
            "caSecret": {"$ref": "#/definitions/secretKeyReference"}
          }
        },
        "resources": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {
        "audience": {"pattern": "^[!-~]{1,256}$"},
        "gateway": {"properties": {"url": {"pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?$"}}}
      }}}]
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "resources": {"type": "object"},
    "initResources": {"type": "object"},
    "packageVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {"sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}}
    },
    "stateVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {"sizeLimit": {"type": "string", "pattern": "^[1-9][0-9]*(Ki|Mi|Gi)$"}}
    },
    "persistence": {"type": "object"},
    "service": {"type": "object"},
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "startup", "readiness", "liveness"],
      "properties": {
        "path": {"type": "string", "pattern": "^/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"},
        "scheme": {"type": "string", "enum": ["HTTP", "HTTPS"]},
        "startup": {"$ref": "#/definitions/startupProbe"},
        "readiness": {"$ref": "#/definitions/periodicProbe"},
        "liveness": {"$ref": "#/definitions/periodicProbe"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "pluginEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^(STELLWERK_PLUGIN_[A-Z0-9_]+|OTEL_[A-Z0-9_]+|SSL_CERT_FILE)$"},
          "value": {"type": "string"},
          "valueFrom": {"type": "object"}
        },
        "oneOf": [{"required": ["value"]}, {"required": ["valueFrom"]}],
        "additionalProperties": false
      }
    },
    "pluginSecretFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secretName", "mountPath", "items"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
          "secretName": {"type": "string", "minLength": 1},
          "mountPath": {"type": "string", "pattern": "^/[^/].*"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "path"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressGateway", "coreGateway", "database", "dns", "registryMirrors", "additionalIngress", "additionalEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressGateway": {"$ref": "#/definitions/peer"},
        "coreGateway": {"$ref": "#/definitions/tcpPeer"},
        "database": {"$ref": "#/definitions/tcpPeer"},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {"$ref": "#/definitions/labels"},
            "podSelector": {"$ref": "#/definitions/labels"}
          }
        },
        "registryMirrors": {"type": "array", "items": {"$ref": "#/definitions/registryMirror"}},
        "additionalIngress": {"type": "array", "items": {"type": "object"}},
        "additionalEgress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "periodicProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds"],
      "properties": {"periodSeconds": {"type": "integer", "minimum": 1, "maximum": 300}}
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failureThreshold", "periodSeconds"],
      "properties": {
        "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 300},
        "periodSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "secretKeyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceSelector", "podSelector"],
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labels"},
        "podSelector": {"$ref": "#/definitions/labels"}
      }
    },
    "registryMirror": {
      "description": "One mirror address or one exact in-cluster peer. Ranges, namespace-only peers and portless rules are rejected.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr", "port"],
          "properties": {
            "cidr": {"type": "string", "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$|^[0-9A-Fa-f:]+/128$"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceSelector", "podSelector", "port"],
          "properties": {
            "namespaceSelector": {"$ref": "#/definitions/labels"},
            "podSelector": {"$ref": "#/definitions/labels"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      ]
    },
    "tcpPeer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaceSelector", "podSelector", "port"],
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/labels"},
        "podSelector": {"$ref": "#/definitions/labels"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {
        "properties": {
          "plugin": {
            "properties": {
              "id": {"pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"},
              "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"}
            }
          },
          "package": {
            "properties": {
              "reference": {"pattern": "@sha256:[0-9a-f]{64}$"},
              "manifestSHA256": {"pattern": "^[0-9a-f]{64}$"}
            }
          },
          "images": {
            "properties": {
              "runtime": {"pattern": "@sha256:[0-9a-f]{64}$"},
              "oras": {"pattern": "@sha256:[0-9a-f]{64}$"}
            }
          },
          "trust": {"properties": {"mode": {"enum": ["development-untrusted", "managed-key-no-tlog"]}}}
        }
      }
    },
    {
      "if": {"properties": {"trust": {"properties": {"mode": {"const": "managed-key-no-tlog"}}}}},
      "then": {
        "properties": {
          "images": {"properties": {"cosign": {"pattern": "@sha256:[0-9a-f]{64}$"}}},
          "trust": {"properties": {
            "bootstrapSecret": {"properties": {"name": {"minLength": 1}}},
            "signatureBundleSecret": {"properties": {"name": {"minLength": 1}}}
          }}
        }
      }
    },
    {
      "if": {"properties": {"migration": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "migration": {
            "properties": {
              "profileSecret": {"properties": {"name": {"minLength": 1}}},
              "databaseSecret": {"properties": {"name": {"minLength": 1}}}
            }
          }
        }
      }
    }
  ]
}
